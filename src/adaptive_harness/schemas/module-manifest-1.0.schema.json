{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-harness.dev/schemas/module-manifest-1.0.schema.json",
  "title": "Adaptive Harness Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "category",
    "type",
    "applies_when",
    "excludes_when",
    "required_capabilities",
    "cost",
    "activation_policy",
    "success_metrics",
    "compatibility",
    "rollback"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "category": {"type": "string", "minLength": 1},
    "type": {"enum": ["declarative", "executable"]},
    "applies_when": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "excludes_when": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_tokens", "runtime_seconds"],
      "properties": {
        "context_tokens": {"type": "integer", "minimum": 0},
        "runtime_seconds": {"type": "number", "minimum": 0}
      }
    },
    "activation_policy": {"enum": ["auto", "suggest", "manual", "disabled"]},
    "success_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_major", "protocol"],
      "properties": {
        "runtime_major": {"type": "integer", "minimum": 0},
        "protocol": {"const": "1.0"}
      }
    },
    "rollback": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "declarative"}}},
      "then": {"required": ["content"], "not": {"required": ["entrypoint"]}}
    },
    {
      "if": {"properties": {"type": {"const": "executable"}}},
      "then": {"required": ["entrypoint"], "not": {"required": ["content"]}}
    }
  ]
}
