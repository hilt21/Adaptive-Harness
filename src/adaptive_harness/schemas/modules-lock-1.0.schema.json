{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-harness.dev/schemas/modules-lock-1.0.schema.json",
  "title": "Adaptive Harness Module Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "modules", "templates"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "modules": {"type": "array", "items": {"$ref": "#/$defs/lockedItem"}},
    "templates": {"type": "array", "items": {"$ref": "#/$defs/lockedItem"}},
    "trials": {"type": "array", "items": {"$ref": "#/$defs/trial"}}
  },
  "$defs": {
    "lockedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source": {"enum": ["builtin", "local"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "enabled": {"type": "boolean"},
        "activation_policy": {"enum": ["auto", "suggest", "manual", "disabled"]},
        "location": {"type": "string", "minLength": 1}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module_id",
        "state",
        "remaining_tasks",
        "matching_tasks",
        "results",
        "previous",
        "success_metrics",
        "cost_budget",
        "control",
        "stop_conditions",
        "rollback"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "module_id": {"type": "string", "minLength": 1},
        "state": {"enum": ["proposed", "approved", "trial", "promoted", "rejected", "rolled_back"]},
        "remaining_tasks": {"type": "integer", "minimum": 0},
        "matching_tasks": {"type": "integer", "minimum": 1},
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "evidence_ref", "beneficial", "overhead_ms"],
            "properties": {
              "task_id": {"type": "string", "minLength": 1},
              "evidence_ref": {"type": "string", "minLength": 1},
              "beneficial": {"type": "boolean"},
              "overhead_ms": {"type": "integer", "minimum": 0}
            }
          }
        },
        "previous": {"type": ["object", "null"]},
        "success_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "cost_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context_tokens", "runtime_ms"],
          "properties": {
            "context_tokens": {"type": "integer", "minimum": 0},
            "runtime_ms": {"type": "integer", "minimum": 0}
          }
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "activation_policy"],
          "properties": {
            "enabled": {"type": "boolean"},
            "activation_policy": {"enum": ["auto", "suggest", "manual", "disabled"]}
          }
        },
        "stop_conditions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximum_tasks", "minimum_beneficial_rate"],
          "properties": {
            "maximum_tasks": {"type": "integer", "minimum": 1},
            "minimum_beneficial_rate": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "rollback": {"type": "string", "minLength": 1},
        "history": {
          "type": "array",
          "items": {"enum": ["proposed", "approved", "trial", "promoted", "rejected", "rolled_back"]}
        }
      }
    }
  }
}
