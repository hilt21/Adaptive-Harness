{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-harness.dev/schemas/installation-1.0.schema.json",
  "title": "Adaptive Harness Standalone Installation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "channel",
    "version",
    "binary_path",
    "data_root",
    "runtime_path",
    "release_base",
    "release_repository",
    "path_profile"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "channel": {"const": "standalone"},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "binary_path": {"type": "string", "pattern": "^/"},
    "data_root": {"type": "string", "pattern": "^/"},
    "runtime_path": {"type": "string", "pattern": "^/"},
    "release_base": {"type": "string", "minLength": 1},
    "release_repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "path_profile": {
      "oneOf": [
        {"type": "string", "pattern": "^/"},
        {"type": "null"}
      ]
    }
  }
}
