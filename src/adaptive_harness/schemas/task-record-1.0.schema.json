{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-harness.dev/schemas/task-record-1.0.schema.json",
  "title": "Adaptive Harness Task Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "state",
    "envelope_revisions",
    "events",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "state": {
      "enum": [
        "draft",
        "active",
        "completed",
        "accepted_with_risk",
        "blocked",
        "failed",
        "abandoned"
      ]
    },
    "envelope_revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://adaptive-harness.dev/schemas/task-envelope-1.0.schema.json"
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "type", "occurred_at", "data"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "type": {"type": "string", "minLength": 1},
          "occurred_at": {"type": "string", "format": "date-time"},
          "data": {"type": "object"}
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}

