{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-harness.dev/schemas/capabilities-1.0.schema.json",
  "title": "Adaptive Harness Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "capabilities": {
      "type": "array",
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "argv",
        "cwd",
        "timeout_seconds",
        "read_paths",
        "write_paths",
        "network",
        "listener",
        "side_effects",
        "reversibility",
        "environment",
        "approval_policy",
        "max_executions",
        "stop_condition"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "cwd": {"$ref": "#/$defs/relativePath"},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "read_paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/relativePath"},
          "uniqueItems": true
        },
        "write_paths": {
          "type": "array",
          "items": {"$ref": "#/$defs/relativePath"},
          "uniqueItems": true
        },
        "network": {"enum": ["none", "outbound"]},
        "listener": {"type": "boolean"},
        "side_effects": {
          "type": "array",
          "items": {
            "enum": [
              "filesystem_read",
              "filesystem_write",
              "network",
              "listener",
              "dependency_change",
              "migration",
              "credentials",
              "production",
              "irreversible"
            ]
          },
          "uniqueItems": true
        },
        "reversibility": {
          "enum": ["reversible", "conditional", "irreversible"]
        },
        "environment": {
          "enum": ["local", "test", "staging", "production"]
        },
        "approval_policy": {"enum": ["auto", "ask", "deny"]},
        "max_executions": {"type": "integer", "minimum": 1},
        "stop_condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exit_codes"],
          "properties": {
            "exit_codes": {
              "type": "array",
              "items": {"type": "integer"},
              "uniqueItems": true
            }
          }
        }
      }
    }
  }
}
